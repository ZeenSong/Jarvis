DATABASE_URL=postgres://jarvis:change-me@127.0.0.1:5432/jarvis
HOST=127.0.0.1
PORT=8080
AGENT_DEGRADED_SECONDS=30
AGENT_OFFLINE_SECONDS=90
EVENT_RETENTION_DAYS=30
NETWORK_INTERFACE=
# M3.2 Authentik OIDC (leave unset to keep break-glass local admin only).
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://your-tailnet-host/api/v2/auth/oidc/callback
AUTHENTIK_OIDC_SCOPES=openid profile email
# In Kubernetes mount host root read-only at /host
HOST_ROOT=
# Provider credentials belong to the agent process, never Android.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_PROVIDER=openai
LLM_MODEL=

# M2: unavailable credentials produce a visible error; no simulated fallback.
CORE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Hermes runs Jarvis as the named native Agent profile. HERMES_API_KEY is the
# gateway key; provision HERMES_PROFILE_API_KEY separately when desired.
HERMES_ENABLED=0
HERMES_URL=http://hermes-core:8642/p/jarvis
HERMES_PROFILE=jarvis
HERMES_MODEL=deepseek-flash
HERMES_API_KEY=
HERMES_PROFILE_API_KEY=
HERMES_BRIDGE_KEY=
# Third-party service credentials are machine identities, separate from OIDC.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
FRIGATE_URL=
FRIGATE_TOKEN=
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
IMMICH_URL=
IMMICH_API_KEY=
INTEGRATION_CREDENTIAL_KEY=
# Optional read-only deployment smoke target; not consumed by Jarvis server.
JARVIS_BASE_URL=http://127.0.0.1:8080
OPS_MODEL=
# Verified cheapest available model for Codex acceptance tests (2026-09-08).
CODING_MODEL=gpt-5.6-luna
CODING_REPOSITORY=
CODING_COMMIT=
WORKER_CONTROLLER_URL=
CONTROLLER_TOKEN=
OPS_TOKEN=
# WEB_ORIGIN=https://your-tailnet-host
CODING_TIMEOUT_MS=1800000
OPS_TIMEOUT_MS=300000
ARTIFACT_RETENTION_DAYS=30

# --- 声明式集成（2026-10 重构新增） --------------------------------------------
# 指向一个目录，里面放集成 manifest JSON。放进一个文件即可接入新应用，
# 无需修改服务端代码。内置 Home Assistant 与 Immich，可在此追加第三方 MCP。
# INTEGRATIONS_DIR=/config/integrations
#
# --- CasaOS 应用目录（2026-10 应用连接） ---------------------------------------
# CasaOS 已登录会话文件（由应用页的“重新连接 CasaOS”写入）。应用目录用它
# 读取已安装应用、端口映射，并把新应用通知给管理员。
# CASAOS_SESSION_FILE=/var/lib/jarvis-casaos/casaos-session.json
# CasaOS 的公网/Tailnet 地址；用于推导应用地址和凭据创建页面链接。
# CASAOS_PUBLIC_URL=http://your-tailnet-host
#
# 自动连接的地址白名单。默认只允许 CasaOS 主机、私有网段、.local/.lan/.ts.net。
# 如果应用使用公网域名，把主机名加入这里，或显式允许所有公网地址：
# APP_URL_ALLOWLIST=apps.example.com,media.example.com
# ALLOW_PUBLIC_APP_URLS=0
# 应用连接配置保存在数据库中；凭据使用 INTEGRATION_CREDENTIAL_KEY 加密。
#
# --- 长期记忆（Obsidian） -------------------------------------------------------
# 记忆库使用的集成 id（默认 obsidian）与索引笔记路径（相对 Obsidian 仓库根目录）。
# 每次对话开始时 Jarvis 读取该笔记，作为长期上下文注入；写入仍由模型通过
# vault_append / vault_write 完成。留空则使用下面的默认值。
# JARVIS_MEMORY_PROVIDER=obsidian
# JARVIS_MEMORY_INDEX=Jarvis/Memory/Index.md
#
# 反向代理部署时设为 1，登录限流才会使用 X-Forwarded-For 作为客户端地址。
# 直连部署请保持未设置，否则恶意请求可以伪造来源绕过限流。
# TRUST_PROXY=1

# --- 自建语音识别（Whisper） ---------------------------------------------------
# 华为等无 GMS 设备没有系统语音识别服务。把 SPEECH_BASE_URL 指向局域网内的
# Speaches / faster-whisper OpenAI 兼容服务，Android 语音页即可使用“云端识别”。
# 服务只应在私有 Docker 网络监听，不要把 Whisper 端口直接暴露到公网。
# SPEECH_BASE_URL=http://jarvis-whisper:8000/v1
# SPEECH_API_KEY=change-me
# SPEECH_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# SPEECH_STT_LANGUAGE=zh
# SPEECH_TIMEOUT_MS=60000
# SPEECH_MAX_AUDIO_BYTES=8388608

# --- DeepSeek Harness（默认 Coding Agent） ------------------------------------
# coding-agent 的默认执行器。DSH 以 headless --json 运行，工作区内的工具调用
# 会映射为 Jarvis 的任务执行步骤。DSH 二进制由 npm 依赖提供：
#   node_modules/.bin/dsh
# DSH_WORKSPACE 是它可读写的代码目录；DSH_HOME 持久化 session/profile。
# DSH_ENABLED=1
# DSH_BIN=node_modules/.bin/dsh
# DSH_HOME=/DATA/AppData/jarvis/dsh
# DSH_WORKSPACE=/home/root2023/Codes/Projects/Jarvis
# DEEPSEEK_API_KEY=change-me
