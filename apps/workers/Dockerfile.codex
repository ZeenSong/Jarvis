FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 ripgrep && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.153.4
WORKDIR /app
COPY apps/workers/codex.mjs ./
COPY apps/workers/codex-auth.mjs ./
COPY apps/workers/host.mjs ./
USER 1000:1000
ENV WORKER_TYPE=codex
CMD ["node","/app/host.mjs"]
