# Runtime secrets are stored outside the repository in
# /DATA/AppData/jarvis/config/{postgres,hermes,server}.env.
# The checked-in Compose file contains no credentials.

# Host paths used by the optional Node Bridge. Use absolute paths and never
# commit the real values in a personal fork if they reveal account names.
CODEX_SEED_DIR=/path/to/codex-home
JARVIS_WORKSPACE_DIR=/path/to/Jarvis
